{
  "name": "xiaoren-er-insurance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-v7.mjs dev",
    "build": "node scripts/run-v7.mjs build",
    "start": "node scripts/run-v7.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/chat.test.ts tests/rag.test.ts tests/agent.test.ts tests/workflow.test.ts tests/quality.test.ts tests/langgraph.test.ts tests/knowledge-management.test.ts tests/migration-tool.test.ts tests/reports.test.ts tests/branding.test.ts tests/showcase.test.ts tests/comparison.test.ts tests/local-library.test.ts tests/data-platform.test.ts tests/data-platform-enhancement.test.ts tests/evaluation.test.ts tests/model-center.test.ts",
    "test:quality": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/quality.test.ts",
    "test:rag": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/rag.test.ts",
    "test:workflow": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/workflow.test.ts",
    "test:agent": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/agent.test.ts",
    "test:langgraph": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/langgraph.test.ts",
    "test:knowledge-management": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/knowledge-management.test.ts",
    "rag:migrate": "node --conditions=react-server --import tsx scripts/rag-migrate.ts",
    "test:migration": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/migration-tool.test.ts",
    "dev:v7": "node scripts/run-v7.mjs dev",
    "start:v7": "node scripts/run-v7.mjs start",
    "setup:report-font": "node scripts/setup-report-font.mjs",
    "test:reports": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/reports.test.ts",
    "test:branding": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/branding.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:serve": "node scripts/e2e-server.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report tmp/reports/e2e/latest/html",
    "test:e2e:before": "node scripts/e2e-screenshots.mjs before",
    "test:e2e:after": "node scripts/e2e-screenshots.mjs after",
    "test:e2e:compare": "node scripts/e2e-compare-screenshots.mjs",
    "test:acceptance": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "test:data-platform": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/data-platform.test.ts",
    "data-platform:audit": "node --conditions=react-server --import tsx scripts/data-platform-audit.ts --registered-readonly",
    "test:data-observation": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/data-platform-enhancement.test.ts",
    "data-platform:observation-migrate": "node --conditions=react-server --import tsx scripts/platform-observation-migrate.ts",
    "test:evaluation": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/evaluation.test.ts",
    "test:model-center": "node --conditions=react-server --import tsx --import ./tests/isolation-setup.mjs --test tests/model-center.test.ts",
    "check:brand": "node --import tsx scripts/check-brand.ts",
    "check": "next typegen && pnpm check:brand && pnpm typecheck",
    "setup:embedding": "node scripts/setup-embedding.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
